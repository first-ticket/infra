# 필수
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#keycloak
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_PORT=8180

# 선택 (기본값 사용 시 생략 가능)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# KAFKA_PORT=9092
# KAFKA_UI_PORT=8989

# 배포 환경 전용 (docker-compose.prod.yml 사용 시)
# .env.prod 파일을 별도로 생성하여 EC2에만 보관 (git 제외)
# Keycloak이 RDS에 접속할 때 아래 변수를 사용합니다
# DB_HOST=<RDS 엔드포인트>.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=<DB명>
# DB_USERNAME=<RDS 사용자>
# DB_PASSWORD=<RDS 비밀번호>